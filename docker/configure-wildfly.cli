embed-server --server-config=standalone.xml --std-out=echo

# 1. Ajouter le module du pilote PostgreSQL
module add --name=org.postgresql --resources=/tmp/postgresql.jar --dependencies=javax.api,javax.transaction.api

# 2. Enregistrer le driver JDBC dans WildFly
/subsystem=datasources/jdbc-driver=postgresql:add(driver-name=postgresql,driver-module-name=org.postgresql,driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)

# 3. Créer la DataSource JNDI exactement au nom attendu par Brish (java:/jdbc/BrishDS)
data-source add \
    --name=BrishDS \
    --jndi-name=java:/jdbc/BrishDS \
    --driver-name=postgresql \
    --connection-url=${env.BRISH_DB_URL} \
    --user-name=${env.BRISH_DB_USER} \
    --password=${env.BRISH_DB_PASSWORD} \
    --validate-on-match=true \
    --background-validation=false \
    --valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker \
    --exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter

stop-embedded-server
